{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SPFx Start (Heft)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "start"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": {
            "regexp": "^(.*)$",
            "message": 1
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Starting incremental build...|---- build started ----",
            "endsPattern": "---- build finished \\([0-9.]+s\\) ----|Project is running at"
          }
        }
      ]
    },
    {
      "label": "SPFx Build (Heft)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "problemMatcher": []
    }
  ]
}
